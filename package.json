{
  "name": "kawer-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint scripts assets/js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/site.test.mjs",
